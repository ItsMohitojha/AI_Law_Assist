# Virtual environment
venv/
.venv/

# Environment variables / secrets
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# FAISS index (large binary, rebuild with build_index.py)
faiss_index/

# Legal PDFs (large files, not suitable for git)
data/*.pdf

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Agent/Gemini local state (session-specific, not project code)
.gemini/

# Static duplicates
static/

# Misc
*.log
